{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000\\r\\n]+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "conversations", "messages"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "conversations": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "messages": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_type", "source_files", "selection", "units"],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "source_type": {"const": "conversation-table"},
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/file"}
    },
    "selection": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "bytes", "selected_conversations"],
          "properties": {
            "path": {"$ref": "#/$defs/relative_path"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "selected_conversations": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
          }
        }
      ]
    },
    "units": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
  }
}
