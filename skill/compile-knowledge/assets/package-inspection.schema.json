{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "units", "source_types", "source_files", "spans"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "units": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "source_types": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
    },
    "source_files": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "spans": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
  }
}
